# Copy to .env. Only needed for Live mode and record.py.
# Any OpenAI-compatible endpoint that serves both chat and embeddings works.
OPENAI_API_KEY=your-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Liara example:
# OPENAI_BASE_URL=<your LIARA_BASE_URL>
# MODEL=openai/gpt-4o-mini
# EMBED_MODEL=openai/text-embedding-3-small
