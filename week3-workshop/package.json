{
  "name": "week3-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "part1": "cd part1-brittle && tsx --env-file=../.env harness.ts",
    "part2": "cd part2-durable && tsx --env-file=../.env harness.ts",
    "part2:crash": "cd part2-durable && CRASH_AT_STEP=2 tsx --env-file=../.env harness.ts",
    "part2:inspect": "cd part2-durable && tsx inspectLog.ts",
    "part2dbos": "cd part2-dbos && DBOS__APPVERSION=week3-demo tsx --env-file=../.env harness.ts",
    "part2dbos:crash": "cd part2-dbos && CRASH_AT_STEP=2 DBOS__APPVERSION=week3-demo tsx --env-file=../.env harness.ts",
    "part2dbos:recover": "cd part2-dbos && DBOS__APPVERSION=week3-demo tsx --env-file=../.env harness.ts --recover-only",
    "part2dbos:inspect": "cd part2-dbos && DBOS__APPVERSION=week3-demo tsx --env-file=../.env inspectDbos.ts",
    "part3:sandbox": "cd part3-sandbox && tsx --env-file=../.env testSandbox.ts",
    "part3": "cd part3-sandbox && tsx --env-file=../.env harness.ts",
    "part4": "cd part4-memory && tsx --env-file=../.env harness.ts",
    "part5": "cd part5-handoffs && tsx --env-file=../.env harness.ts",
    "part6": "cd part6-supervision && tsx --env-file=../.env harness.ts --supervised",
    "part6:chaos": "cd part6-supervision && CHAOS_FAIL=technical tsx --env-file=../.env harness.ts --supervised",
    "part7": "cd part7-approval && tsx --env-file=../.env harness.ts",
    "part7:approve": "cd part7-approval && tsx approve.ts",
    "part7:resume": "cd part7-approval && tsx --env-file=../.env harness.ts --resume-only",
    "typecheck": "tsc --noEmit",
    "reset": "rm -rf part*/wf part*/decisions part*/events.jsonl && echo 'all demo state cleared'",
    "part2dbos:reset": "cd part2-dbos && DBOS__APPVERSION=week3-demo tsx --env-file=../.env resetDbos.ts"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^4.26.10",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}